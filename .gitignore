.env
.env.save
.DS_Store
**/.DS_Store

# APNs auth keys are never committed.
/secrets/
**/AuthKey_*.p8

# Admin-uploaded resource library JSON (per-edition folders under storage/resource_library/)
/storage/resource_library/
/storage/easa_erules/

# Runtime-generated files. Uploaded recordings, reconstruction/debug output,
# PDF font caches, and temp artifacts must not be deployed from Git.
/storage/cockpit_recorder/
/storage/cvr/
/storage/tmp/
/storage/analytics/
/tmp/analytics/

# Local iOS app containers and cockpit audio repair test bundles are too large
# for Git and must remain machine-local evidence.
*.xcappdata/
/tmp/cvr-rebuild-test/
